{
  "name": "ckeditor-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that lets any AI agent operate a real CKEditor 5 instance — get/set content, run editor commands, export, and drive premium features over MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ckeditor-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "rich-text-editor",
    "llm-tools"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "playwright": "^1.61.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
