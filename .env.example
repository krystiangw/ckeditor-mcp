# CKEditor 5 license key (trial / dev / production).
# Get one at https://portal.ckeditor.com/ — a 14-day trial unlocks all premium features.
# Without a key the server falls back to CKEditor's GPL (open-source) feature set.
CKEDITOR_LICENSE_KEY=

# Optional: which CKEditor 5 version to load from the CDN (defaults to a pinned version).
# CKEDITOR_VERSION=48.3.1

# Optional: run the editor with a visible browser window for debugging (default headless).
# CKEDITOR_HEADLESS=false

# Optional (only needed for the AI tool): your own LLM key, used client-side by the
# CKEditor AI Assistant adapter. Never commit real keys.
# OPENAI_API_KEY=
